###################################################################################################
# Questie server bridge
# Reports live quest availability, resets, locations, and public world progress to Questie-335.
# Reloadable with .reload config. No database installation is required.
###################################################################################################

# Enable the optional bridge. Disabling expires client state after 30 seconds.
# Calendar detection/manual options remain the fallback; no settings are overwritten.
QuestieBridge.Enabled = 1

# Complete catalog of valid game events with live activity and holiday main stages.
# Includes GM starts/stops and non-holiday events such as Quel'Danas unlocks.
QuestieBridge.Events = 1

# Allow up to 16 numeric persistent worldstate subscriptions per player.
# Values use WorldState::getWorldState (missing keys have AC's default value 0).
QuestieBridge.WorldStates = 1

# Publish public Scourge Invasion and Quel'Danas UI progress, from AC's public API.
# This is separate from persistent worldstate storage. No personal data is exposed.
QuestieBridge.Progress = 1

# Observe Elder Clearwater's NPC AI winner flag for the Kalu'ak Fishing Derby.
# Unknown/unloaded NPC state keeps Questie's calendar fallback.
QuestieBridge.Kaluak = 1

# Report all loaded daily/weekly quest pool members and the server's selections.
# Includes custom pools; inactive members are hidden before visiting a questgiver.
QuestieBridge.QuestPools = 1

# Report Wintergrasp control/battle state and scripted attacker/defender quest gates.
# Includes the eight attacking variants that inherit a defending pool selection.
QuestieBridge.Wintergrasp = 1

# Report the weekly quest family and unlocks in each player's current ICC raid instance.
# Outside ICC, Questie keeps its existing behavior; no other lockouts are queried.
QuestieBridge.ICC = 1

# Use the server's weekly/monthly quest reset deadlines in Questie's completion history.
# Daily resets continue using the client's existing API.
QuestieBridge.Resets = 1

# Match NPC/object quest locations to the player's phase in supported story regions.
# Covers Icecrown, Storm Peaks, the death knight start, and other Wrath story areas.
# Filtering is local to the current subarea; other locations keep their usual data.
QuestieBridge.Phases = 1

# Follow moving questgivers and transport passengers in the player's current zone.
# Uses loaded NPCs only; remote or unavailable locations keep the usual marker.
# Samples once per second, limited to 64 visible questgivers. Positions expire after 5 seconds.
QuestieBridge.Patrols = 1

# Report effective normal/DF quest XP rates and the player's active quest-XP aura multiplier.
# Includes GetQuestRate module overrides and heirlooms. Does not execute reward hooks.
# Unknown/invalid rates keep Questie's generated XP calculation. Does not change quest money.
QuestieBridge.QuestXP = 1

# Report global/faction quest reputation rates, reputation auras, grey-quest reduction and RAF.
# Reads loaded server state without executing reputation reward/change hooks.
# Unknown/invalid rates keep Questie's generated faction rates and racial bonus estimate.
QuestieBridge.QuestReputation = 1

# Report ordinary quest money and the separate maximum-level bonus money rates.
# Missing/invalid rates keep Questie's generated money calculation.
QuestieBridge.QuestMoney = 1
