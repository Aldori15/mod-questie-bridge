// The .cpp.in suffix keeps this standalone main out of AC's recursive source collection.
#include "QuestieBridgeStateCache.h"
#include "QuestieBridgeProtocol.h"
#include "QuestieBridgeConditions.h"
#include "QuestieBridgeDelivery.h"

#include <iostream>
#include <map>
#include <memory>
#include <stdexcept>

namespace
{
using namespace std::chrono_literals;
using QuestieBridge::CommonState;
using QuestieBridge::CommonStateCache;
using QuestieBridge::StateClock;
constexpr std::uint32_t ExpectedProtocolVersion = 22;
std::string const Protocol = std::to_string(ExpectedProtocolVersion);

void Require(bool condition, char const* message)
{
    if (!condition)
        throw std::runtime_error(message);
}

void TestQuestConditions()
{
    struct Condition
    {
        std::uint32_t ConditionType = 8;
        std::uint32_t ConditionValue1 = 0;
        std::uint32_t ConditionValue2 = 0;
        std::uint32_t ConditionValue3 = 0;
        std::uint32_t ElseGroup = 0;
        std::uint32_t ReferenceId = 0;
        std::uint32_t ScriptId = 0;
        std::uint32_t ConditionTarget = 0;
        std::uint32_t SourceGroup = 0;
        std::int32_t SourceId = 0;
        bool NegativeCondition = false;
    } component{8, 8970}, progression{8, 66008}, alliance{8, 108850}, horde{8, 108855, 0, 0, 1};
    using List = std::vector<Condition const*>;
    std::map<std::uint32_t, List> lists = {{8985, {&component}}, {11451, {&progression}},
        {8286, {&alliance, &horde}}, {90000, {&component}}};
    std::map<std::uint32_t, int> quests = {{8985, 1}, {11451, 1}, {8286, 1}, {90000, 1}};
    std::map<std::uint32_t, List> references;
    std::size_t lookups = 0, evaluations = 0;
    auto conditions = [&](std::uint32_t id) { ++lookups; return lists[id]; };
    auto refs = [&](std::uint32_t id) { return references[id]; };
    auto index = QuestieBridge::BuildQuestConditionIndex(quests, conditions, refs);
    Require(index && index->Quests == 4 && index->Groups.size() == 3, "identical complete expressions share evaluation");
    auto append = [&](std::set<std::uint32_t> const& rewarded)
    {
        std::vector<std::string> rows;
        std::string caps;
        QuestieBridge::AppendQuestConditions(*index, [&](std::uint32_t id)
        {
            ++evaluations;
            // This fixture models these loaded quest expressions; production calls Player's API.
            if (id == 8286)
                return rewarded.contains(108850) || rewarded.contains(108855);
            return rewarded.contains(id == 11451 ? 66008 : 8970);
        }, rows, caps, 0);
        Require(caps == "QUESTCONDITIONS", "condition restrictions have a separate capability");
        return rows;
    };
    auto const closed = append({8964});
    Require(closed == std::vector<std::string>{"P:QC_COUNT:4", "C:8286", "C:8985", "C:11451", "C:90000"},
        "8985 requires 8970 even when the static alternative 8964 is completed");
    auto const opened = append({8970, 66008, 108855});
    Require(opened == std::vector<std::string>{"P:QC_COUNT:0"}, "8286 accepts either faction and positive results send no grants");
    Require(append({108850})[0] == "P:QC_COUNT:3", "8286 preserves OR logic for the other faction");
    auto const before = evaluations;
    for (int player = 0; player < 500; ++player)
        Require(append({8964}) == closed, "unchanged player results have identical snapshot signatures");
    Require(lookups == 4 && evaluations - before == 1500,
        "500 subscribers share one discovery scan and evaluate each distinct expression once");

    auto signature = [&](List const& list)
    {
        std::size_t nodes = 0;
        return QuestieBridge::QuestConditionSignature(list, refs, nodes);
    };
    Condition reference;
    reference.ReferenceId = 1;
    references[1] = {&component, &progression};
    Require(signature({&reference}).has_value(), "complete safe references are supported");
    auto const positive = signature({&reference});
    progression.NegativeCondition = true;
    Require(signature({&reference}) != positive, "nested predicate negation is retained");
    progression.NegativeCondition = false;
    reference.NegativeCondition = true;
    Require(!signature({&reference}), "negative reference rows are not interpreted differently from AC");
    reference.NegativeCondition = false;
    references[1] = {&reference};
    Require(!signature({&reference}), "cycles are bounded and rejected");
    references.clear();
    Require(!signature({&reference}), "missing references remain unknown");
    Condition unknown{4, 12};
    for (auto type : {1U, 2U, 4U, 11U, 12U, 13U, 22U, 23U, 26U, 29U})
    {
        unknown.ConditionType = type;
        Require(!signature({&component, &unknown}), "unsafe predicates reject the complete expression");
    }
    Condition level{27, 60, 3}, state{47, 6804, 64};
    Require(signature({&level, &state}).has_value(), "level and quest-state predicates are location independent");
    level.ConditionValue2 = 5;
    Require(!signature({&level}), "comparison sentinel is not an executable level predicate");
    component.ScriptId = 1;
    Require(!signature({&component}), "scripted conditions remain unknown");
    component.ScriptId = 0;
    component.ConditionTarget = 1;
    Require(!signature({&component}), "non-player targets remain unknown");
    component.ConditionTarget = 0;
    Require(!signature(List(QuestieBridge::QuestConditionsMaxNodes + 1, &component)), "expanded node budget is bounded");
    lists[8985] = {&unknown};
    auto const reloaded = QuestieBridge::BuildQuestConditionIndex(quests, conditions, refs);
    Require(reloaded && reloaded->Quests == 3, "reload removes newly contextual expressions from authority");
    Require(index->Quests == 4, "index owns values rather than core Condition pointers");

    QuestieBridge::QuestConditionIndex maximum;
    for (std::uint32_t id = 1; id <= QuestieBridge::QuestConditionsMaxQuests; ++id)
        maximum.Groups["same"].push_back(id);
    maximum.Quests = QuestieBridge::QuestConditionsMaxQuests;
    std::vector<std::string> rows;
    std::string caps;
    Require(QuestieBridge::AppendQuestConditions(maximum, [](auto) { return false; }, rows, caps, 0),
        "bounded negative catalog is complete");
    Require(rows.size() == 513 && QuestieBridge::BuildSnapshotMessages("t", 1, caps, rows).has_value(),
        "maximum condition catalog fits the existing bounded multipart format");
    std::size_t sharedEvaluations = 0;
    auto const started = StateClock::now();
    for (int player = 0; player < 500; ++player)
    {
        std::vector<std::string> sample;
        std::string sampleCaps;
        QuestieBridge::AppendQuestConditions(maximum, [&](auto) { ++sharedEvaluations; return false; },
            sample, sampleCaps, 0);
        Require(sample == rows, "maximum repeated catalog has a stable snapshot signature");
    }
    Require(sharedEvaluations == 500, "512 identical quest expressions cost one evaluation per player");
    std::cout << "Conditions: 500 players x 512 quests sharing one predicate, " << sharedEvaluations << " evaluations, "
        << std::chrono::duration_cast<std::chrono::milliseconds>(StateClock::now() - started).count() << " ms\n";
    rows.assign(4095, "D:1");
    caps = "QUESTDISABLES";
    Require(!QuestieBridge::AppendQuestConditions(maximum, [](auto) { return false; }, rows, caps, 1)
        && rows.size() == 4095 && caps == "QUESTDISABLES", "overflow never advertises a partial condition catalog");
    quests.clear();
    for (std::uint32_t id = 1; id <= QuestieBridge::QuestConditionsMaxQuests + 1; ++id)
    {
        quests[id] = 1;
        lists[id] = {&progression};
    }
    Require(!QuestieBridge::BuildQuestConditionIndex(quests, conditions, refs), "oversized supported index fails closed");
    QuestieBridge::QuestConditionIndex distinct;
    for (std::uint32_t id = 1; id <= QuestieBridge::QuestConditionsMaxQuests; ++id)
        distinct.Groups[std::to_string(id)] = {id};
    distinct.Quests = QuestieBridge::QuestConditionsMaxQuests;
    std::size_t distinctEvaluations = 0;
    for (int player = 0; player < 500; ++player)
    {
        std::vector<std::string> sample;
        std::string sampleCaps;
        QuestieBridge::AppendQuestConditions(distinct, [&](auto) { ++distinctEvaluations; return true; },
            sample, sampleCaps, 0);
        Require(sample == std::vector<std::string>{"P:QC_COUNT:0"}, "distinct satisfied expressions never send grants");
    }
    Require(distinctEvaluations == 500 * QuestieBridge::QuestConditionsMaxQuests,
        "distinct-expression work stays within the per-player budget");

    std::map<std::uint32_t, int> catalog;
    for (std::uint32_t id = 1; id <= 1000; ++id)
        catalog[id] = 1;
    auto safe = std::make_unique<Condition>(Condition{8, 66008});
    Condition contextual{4, 12};
    std::map<std::uint32_t, List> loaded = {{100, {safe.get()}}, {200, {&contextual}}};
    std::size_t candidateLookups = 0;
    auto currentConditions = [&](std::uint32_t id)
    {
        ++candidateLookups;
        auto const found = loaded.find(id);
        return found == loaded.end() ? List{} : found->second;
    };
    auto candidates = QuestieBridge::FindQuestConditionCandidates(catalog, currentConditions);
    Require(candidateLookups == 1000 && candidates.size() == 2 && candidates.at(100) && candidates.at(200),
        "discovery keeps condition-bearing IDs, including currently unsupported expressions");
    candidateLookups = 0;
    for (int update = 0; update < 1000; ++update)
    {
        auto const current = QuestieBridge::BuildQuestConditionIndex(candidates, currentConditions, refs);
        Require(current && current->Quests == 1, "each pass classifies only the current candidate expressions");
    }
    Require(candidateLookups == 2000, "1000 classification passes inspect two candidates, not 1000 quest templates");
    auto const beforeReload = QuestieBridge::BuildQuestConditionIndex(candidates, currentConditions, refs);
    loaded[100] = {&contextual};
    safe.reset();
    auto current = QuestieBridge::BuildQuestConditionIndex(candidates, currentConditions, refs);
    Require(current && !current->Quests && beforeReload && beforeReload->Quests == 1,
        "reload reclassifies newly unsafe conditions without retaining condition pointers");
    loaded[100].clear();
    loaded[300] = {&progression};
    current = QuestieBridge::BuildQuestConditionIndex(candidates, currentConditions, refs);
    Require(current && !current->Quests, "removed conditions drop authority before candidate rediscovery");
    candidates = QuestieBridge::FindQuestConditionCandidates(catalog, currentConditions);
    current = QuestieBridge::BuildQuestConditionIndex(candidates, currentConditions, refs);
    Require(candidates.size() == 2 && !candidates.contains(100) && candidates.contains(300)
        && current && current->Quests == 1 && current->Groups.begin()->second == std::vector<std::uint32_t>{300},
        "rediscovery finds added condition-bearing quests and removes empty entries");
    std::cout << "Condition discovery: 1000 templates once; 1000 subsequent passes, 2000 candidate lookups\n";
}

void TestWireCapabilities()
{
    std::array<std::string_view, 19> const names = {{
        "EVENTS", "VALUES", "SCOURGE", "QUELDANAS", "KALUAK", "HEARTBEAT",
        "QUESTPOOLS", "WINTERGRASP", "ICC", "RESETS", "PHASES", "PATROLS",
        "QUESTXP", "QUESTREP", "QUESTMONEY", "QUESTDISABLES", "QUESTGIVERS", "QUESTGIVERTEMPLATES", "QUESTCONDITIONS"
    }};
    std::string all;
    for (std::size_t index = 0; index < names.size(); ++index)
    {
        QuestieBridge::CapabilityMask mask{};
        mask[0] = std::uint32_t{1} << index;
        Require(QuestieBridge::EncodeCapabilities(names[index]) == QuestieBridge::EncodeCapabilityMask(mask),
            "each named capability keeps its assigned wire bit");
        if (!all.empty())
            all += ',';
        all += names[index];
    }
    Require(QuestieBridge::EncodeCapabilities(all) == "0007FFFF", "all wire capabilities fit one word");
    Require(QuestieBridge::EncodeCapabilities("HEARTBEAT,EVENTS") == "00000021", "name order is irrelevant");
    Require(QuestieBridge::EncodeCapabilities("") == "00000000", "empty capability set has one zero word");
    for (auto invalid : {"UNKNOWN", "EVENTS,EVENTS", ",EVENTS", "EVENTS,", "EVENTS,,HEARTBEAT"})
        Require(!QuestieBridge::EncodeCapabilities(invalid), "unknown, duplicate and empty names fail closed");
    Require(QuestieBridge::EncodeCapabilityMask({0x80000000U, 0, 0, 0}) == "80000000",
        "bit 31 stays unsigned and trailing zero words are omitted");
    Require(QuestieBridge::EncodeCapabilityMask({0, 1, 0, 0}) == "00000000.00000001",
        "bit 32 starts the second word");
    Require(QuestieBridge::EncodeCapabilityMask({0xFFFFFFFFU, 0, 0, 0x80000000U})
        == "FFFFFFFF.00000000.00000000.80000000", "bit 127 preserves intermediate zero words");
}

void TestSnapshotEncoding()
{
    using QuestieBridge::BuildSnapshotMessages;
    std::string const token(32, 'T');
    constexpr std::uint64_t sequence = 9007199254740991ULL;
    std::string all;
    for (auto const& capability : QuestieBridge::WireCapabilities)
    {
        if (!all.empty())
            all += ',';
        all += capability.Name;
    }
    auto const full = BuildSnapshotMessages(token, sequence, all, std::vector<std::string>(4096, std::string(36, 'x')));
    Require(full && full->size() == 1026, "maximum rows and parts form one complete batch");
    std::string const emptyCatalogId(64, '0');
    Require(QuestieBridge::ProtocolVersion == ExpectedProtocolVersion, "bridge protocol matches the fixture contract");
    Require(full->front() == "BEGIN~" + Protocol + "~" + token + "~9007199254740991~0007FFFF~4096~1024~" + emptyCatalogId + "~0",
        "maximum BEGIN carries compact capabilities and catalog metadata");
    Require(full->front().size() == 142 + Protocol.size(), "maximum current BEGIN size tracks the protocol digits");
    std::string const futureBegin = "BEGIN~" + Protocol + "~" + token + "~9007199254740991~"
        + QuestieBridge::EncodeCapabilityMask({0xFFFFFFFFU, 0xFFFFFFFFU, 0xFFFFFFFFU, 0xFFFFFFFFU})
        + "~4096~1024~" + emptyCatalogId + "~0";
    Require(futureBegin.size() == 169 + Protocol.size(), "future four-word capability mask still fits the payload limit");
    Require(full->back() == "END~" + Protocol + "~" + token + "~9007199254740991", "END retains the snapshot anchor");
    for (auto const& message : *full)
        Require(message.size() <= 240, "every serialized message obeys the payload limit");
    auto const empty = BuildSnapshotMessages("t", 1, "", {});
    Require(empty && *empty == std::vector<std::string>{"BEGIN~" + Protocol + "~t~1~00000000~0~0~" + emptyCatalogId + "~0", "END~" + Protocol + "~t~1"},
        "empty snapshots remain complete and atomic");
    auto const packed = BuildSnapshotMessages("t", 2, "EVENTS,HEARTBEAT", {"E:1:0:0", "E:2:0:0"});
    Require(packed && (*packed)[1] == "PART~" + Protocol + "~t~2~1~E:1:0:0;E:2:0:0", "multipart row encoding is unchanged");
    Require(BuildSnapshotMessages(token, sequence, "HEARTBEAT", {std::string(150, 'x')}).has_value(),
        "maximum part body fits with the longest token and sequence");
    Require(!BuildSnapshotMessages(token, sequence, "HEARTBEAT", {std::string(151, 'x')}),
        "oversized single row cannot produce an oversized PART");
    Require(!BuildSnapshotMessages(token, sequence, "HEARTBEAT", std::vector<std::string>(1025, std::string(150, 'x'))),
        "too many parts reject the entire snapshot");
    Require(!BuildSnapshotMessages(token, sequence, "HEARTBEAT", std::vector<std::string>(4097, "D:1")),
        "too many rows reject the entire snapshot");
    Require(!BuildSnapshotMessages(token, sequence, "HEARTBEAT", {""}), "empty rows are rejected");
    Require(!BuildSnapshotMessages(token, sequence, "UNKNOWN", {}), "unknown capabilities cannot be advertised");
    Require(!BuildSnapshotMessages(token + 'T', sequence, "HEARTBEAT", {}), "oversized tokens are rejected");
    Require(!BuildSnapshotMessages("", sequence, "HEARTBEAT", {}), "empty tokens are rejected");
    Require(!BuildSnapshotMessages("bad~token", sequence, "HEARTBEAT", {}), "invalid tokens are rejected");
    Require(!BuildSnapshotMessages(token, 0, "HEARTBEAT", {}), "zero sequence is rejected");
    Require(!BuildSnapshotMessages(token, sequence + 1, "HEARTBEAT", {}), "inexact Lua sequences are rejected");
}

std::vector<std::string> BeginFields(std::vector<std::string> const& messages)
{
    std::vector<std::string> fields;
    std::string_view remaining = messages.front();
    for (;;)
    {
        auto const separator = remaining.find('~');
        fields.emplace_back(remaining.substr(0, separator));
        if (separator == std::string_view::npos)
            return fields;
        remaining.remove_prefix(separator + 1);
    }
}

void TestSnapshotCatalogs()
{
    using QuestieBridge::BuildSnapshotCatalog;
    using QuestieBridge::BuildSnapshotMessages;
    std::string const id(64, 'A');
    auto const catalog = BuildSnapshotCatalog(id, {"E:1:0:0", "Q:13830:5676"});
    Require(catalog && catalog->RowCount == 2 && catalog->Parts.size() == 1, "shared rows pack once into an owned catalog");
    auto const full = BuildSnapshotMessages("t", 1, "EVENTS,QUESTPOOLS", {"P:LOCAL:1"}, *catalog);
    auto const reference = BuildSnapshotMessages("t", 2, "EVENTS,QUESTPOOLS", {"P:LOCAL:1"}, *catalog, true);
    Require(full && reference, "full and reference snapshots serialize through production helpers");
    auto const fullFields = BeginFields(*full);
    auto const refFields = BeginFields(*reference);
    Require(fullFields.size() == 9 && refFields.size() == 9, "BEGIN has nine fields");
    Require(fullFields[5] == "3" && fullFields[6] == "2" && fullFields[7] == id && fullFields[8] == "2",
        "full BEGIN reports transmitted rows, parts, identity and shared prefix length");
    Require(refFields[5] == "1" && refFields[6] == "1" && refFields[7] == id && refFields[8] == "R",
        "reference BEGIN reports only private transmission and names the catalog");
    Require(std::stoull(fullFields[5]) == std::stoull(refFields[5]) + catalog->RowCount,
        "full and reference batches resolve to the same effective row count");
    Require((*full)[1] == "PART~" + Protocol + "~t~1~1~E:1:0:0;Q:13830:5676"
        && (*full)[2] == "PART~" + Protocol + "~t~1~2~P:LOCAL:1" && (*reference)[1] == "PART~" + Protocol + "~t~2~1~P:LOCAL:1",
        "full batches send shared prefix first and references omit it");
    auto const noLocal = BuildSnapshotMessages("t", 3, "EVENTS", {}, *catalog, true);
    Require(noLocal && noLocal->size() == 2 && BeginFields(*noLocal)[5] == "0"
        && BeginFields(*noLocal)[6] == "0", "reference-only snapshots allow zero local rows and zero parts");
    auto const sharedOnly = BuildSnapshotMessages("t", 4, "EVENTS", {}, *catalog);
    Require(sharedOnly && sharedOnly->size() == 3 && BeginFields(*sharedOnly)[5] == "2",
        "full catalog with zero local rows still transmits the shared prefix");
    auto const maximum = BuildSnapshotCatalog(id, std::vector<std::string>(4096, "D:1"));
    Require(maximum && BuildSnapshotMessages("t", 5, "QUESTDISABLES", {}, *maximum).has_value()
        && BuildSnapshotMessages("t", 6, "QUESTDISABLES", {}, *maximum, true).has_value(),
        "4096 logical shared rows fit both forms");
    Require(!BuildSnapshotMessages("t", 7, "QUESTDISABLES", {"P:LOCAL:1"}, *maximum)
        && !BuildSnapshotMessages("t", 8, "QUESTDISABLES", {"P:LOCAL:1"}, *maximum, true),
        "4096 logical row bound includes referenced rows");
    Require(!BuildSnapshotCatalog(id, std::vector<std::string>(4097, "D:1")), "oversized catalog rows fail closed");
    Require(!BuildSnapshotCatalog(id, std::vector<std::string>(1025, std::string(150, 'x'))),
        "oversized catalog parts fail closed");
    Require(!BuildSnapshotCatalog(id, {""}) && !BuildSnapshotCatalog(id, {std::string(151, 'x')}),
        "catalog packing enforces the same row boundaries as local packing");
    for (auto const& invalid : std::vector<std::string>{"", std::string(63, 'A'), std::string(65, 'A'),
        std::string(64, 'a'), std::string(64, 'G')})
    {
        Require(!BuildSnapshotCatalog(invalid, {}), "catalog identity requires exactly 64 uppercase hexadecimal characters");
        auto malformed = *catalog;
        malformed.Id = invalid;
        Require(!BuildSnapshotMessages("t", 1, "EVENTS", {}, malformed)
            && !BuildSnapshotMessages("t", 1, "EVENTS", {}, malformed, true), "malformed catalog identity fails in both batch forms");
    }
    auto oversized = *catalog;
    oversized.RowCount = 4097;
    Require(!BuildSnapshotMessages("t", 1, "EVENTS", {}, oversized, true), "reference cannot bypass catalog row bounds");
    auto const manyParts = BuildSnapshotCatalog(id, std::vector<std::string>(512, std::string(150, 'x')));
    Require(manyParts.has_value(), "512 shared parts are individually valid");
    Require(BuildSnapshotMessages("t", 1, "EVENTS", std::vector<std::string>(512, std::string(150, 'y')), *manyParts).has_value(),
        "exact combined part boundary is accepted");
    Require(!BuildSnapshotMessages("t", 1, "EVENTS", std::vector<std::string>(513, std::string(150, 'y')), *manyParts),
        "combined shared and private parts cannot exceed 1024");
    Require(BuildSnapshotMessages("t", 1, "EVENTS", std::vector<std::string>(513, std::string(150, 'y')), *manyParts, true).has_value(),
        "reference part count excludes shared bodies while retaining logical row bounds");
}

void TestCatalogWireReduction()
{
    // Deterministic payload model, not a benchmark: identical framing, a fixed
    // 32-character token, sequences 1/2, and 200 personal rows per subscriber.
    // Protocol 21 invalidates its shared catalog on one live progress change;
    // the current protocol retains the static catalog already acknowledged by all players.
    std::vector<std::string> oldShared, shared;
    for (int id = 1; id <= 182; ++id)
    {
        shared.push_back("E:" + std::to_string(id) + ":0:0");
        oldShared.push_back(shared.back() + (id <= 15 ? ":1" : ":0"));
    }
    for (int id = 1; id <= 161; ++id)
    {
        shared.push_back("Q:" + std::to_string(10000 + id) + ':' + std::to_string(5600 + (id - 1) / 4));
        oldShared.push_back(shared.back() + (id <= 149 && (id - 1) % 4 == 0 ? ":1" : ":0"));
    }
    for (int id = 1; id <= 718; ++id)
    {
        shared.push_back("D:" + std::to_string(20000 + id));
        oldShared.push_back(shared.back());
    }
    std::vector<std::string> progress = {"U:21:50", "R:13830:1", "P:SC_ACTIVE:1",
        "P:KA_FINISHED:0", "P:WG_STATE:1:0:0"};
    shared.push_back("P:QUEST_RESETS:1792058400:1793527200");
    oldShared.push_back(shared.back());
    auto const oldProgressIndex = oldShared.size();
    oldShared.insert(oldShared.end(), progress.begin(), progress.end());
    std::vector<std::string> live = {"P:EVENT_COUNT:15", "P:POOL_COUNT:38"};
    for (int id = 1; id <= 15; ++id)
        live.push_back("A:" + std::to_string(id));
    for (int id = 1; id <= 38; ++id)
        live.push_back("S:" + std::to_string(10001 + (id - 1) * 4));
    auto const liveProgressIndex = live.size();
    live.insert(live.end(), progress.begin(), progress.end());
    std::vector<std::string> personal = {"P:QC_COUNT:198", "P:SERVER_TIME:1792000000"};
    for (int id = 1; id <= 198; ++id)
        personal.push_back("C:" + std::to_string(30000 + id));
    auto suffix = live;
    suffix.insert(suffix.end(), personal.begin(), personal.end());
    std::string const caps = "EVENTS,QUESTPOOLS,QUESTDISABLES,VALUES,RESETS,SCOURGE,KALUAK,WINTERGRASP,QUESTCONDITIONS";
    std::string const token(32, 'T');
    auto const catalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'B'), shared);
    auto const oldCatalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'C'), oldShared);
    Require(catalog && oldCatalog && catalog->RowCount == 1062,
        "static catalog has 182 events, 161 pool mappings, 718 disables and one reset row");
    auto const full = QuestieBridge::BuildSnapshotMessages(token, 1, caps, suffix, *catalog);
    auto const oldFull = QuestieBridge::BuildSnapshotMessages(token, 1, caps, personal, *oldCatalog);
    oldShared[oldProgressIndex] = "U:21:51";
    auto const changedOldCatalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'D'), oldShared);
    suffix[liveProgressIndex] = "U:21:51";
    Require(changedOldCatalog.has_value(), "changed protocol 21 catalog is serializable");
    auto const oldSteady = QuestieBridge::BuildSnapshotMessages(token, 2, caps, personal, *changedOldCatalog);
    auto const reference = QuestieBridge::BuildSnapshotMessages(token, 2, caps, suffix, *catalog, true);
    Require(full && oldFull && oldSteady && reference, "both protocol traffic models serialize with production framing");
    auto bytes = [](std::vector<std::string> const& messages)
    {
        std::size_t total = 0;
        for (auto const& message : messages)
        {
            Require(message.size() <= 240, "traffic comparison obeys serialized message limits");
            total += message.size();
        }
        return total;
    };
    // Encode both catalog layouts with the current framing to isolate reuse savings.
    Require(reference->size() < oldSteady->size() && bytes(*reference) < bytes(*oldSteady),
        "steady live changes avoid retransmitting the acknowledged static catalog");
    constexpr std::size_t players = 1000;
    std::cout << "Condition-heavy traffic model (1000 players; 182 E, 161 Q, 718 D; "
        << "198 C plus count/server time = 200 personal rows; 15 A, 38 S; one U/R plus SC/KA/WG):\n"
        << "  legacy catalog initial/full: " << players * oldFull->size() << " messages/"
        << players * bytes(*oldFull) << " payload bytes; steady change: " << players * oldSteady->size()
        << " messages/" << players * bytes(*oldSteady) << " payload bytes\n"
        << "  stable catalog initial/full: " << players * full->size() << " messages/"
        << players * bytes(*full) << " payload bytes; steady change: " << players * reference->size()
        << " messages/" << players * bytes(*reference) << " payload bytes\n";
}

void TestRefreshAndOwnership()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"EVENTS,HEARTBEAT", {"E:5:0:0"}, std::nullopt, false};
    source.LiveRows = {"P:EVENT_COUNT:0"};
    int builds = 0;
    auto build = [&]() { ++builds; return source; };
    Require(cache.Get(start, 1, false, build).Rows == source.Rows, "initial state built");
    auto revision = cache.GetRevision();
    auto const catalogRevision = cache.GetCatalogRevision();
    source.LiveRows[0] = "P:EVENT_COUNT:1";
    source.LiveRows.push_back("A:5");
    Require(cache.Get(start + 1s, 1, false, build).LiveRows == std::vector<std::string>{"P:EVENT_COUNT:0"},
        "cache owns values rather than borrowed source references");
    Require(builds == 1, "intermediate tick must reuse cache");
    Require(cache.Get(start + 2s, 1, false, build).LiveRows == source.LiveRows, "periodic change detected");
    Require(builds == 2 && cache.GetRevision() != revision, "changed state advances revision");
    Require(cache.GetCatalogRevision() == catalogRevision, "event activity does not change static catalog revision");
    revision = cache.GetRevision();
    cache.Get(start + 4s, 1, false, build);
    Require(builds == 3 && cache.GetRevision() == revision, "unchanged polling preserves revision");
}

void TestDirtyRequestsAndCapabilityReload()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"HEARTBEAT", {}, std::nullopt, false};
    int builds = 0;
    auto build = [&]() { ++builds; return source; };
    cache.Get(start, 1, false, build);
    auto revision = cache.GetRevision();
    cache.Get(start + 100ms, 1, false, build);
    Require(builds == 1 && cache.GetRevision() == revision, "requests do not force shared rebuilding");
    source.Rows = {"Q:13830:5676", "Q:13832:5676"};
    source.LiveRows = {"P:POOL_COUNT:1", "S:13830"};
    cache.Get(start + 200ms, 1, true, build);
    Require(builds == 2 && cache.GetRevision() != revision, "dirty event refreshes immediately");
    revision = cache.GetRevision();
    cache.Get(start + 300ms, 2, false, build);
    Require(builds == 3 && cache.GetRevision() != revision, "capability changes affect player checks");
    revision = cache.GetRevision();
    cache.Get(start + 400ms, 2, true, build);
    Require(builds == 4 && cache.GetRevision() == revision, "same-mask config reload still rebuilds");
}

void TestCatalogChanges()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"HEARTBEAT", {}, std::nullopt, false};
    auto build = [&]() { return source; };
    cache.Get(start, 1, false, build);
    auto revision = cache.GetRevision();
    auto const initialCatalogRevision = cache.GetCatalogRevision();
    source.ReputationRows.emplace();
    cache.Get(start + 2s, 1, false, build);
    Require(cache.GetRevision() != revision, "empty complete rate catalog differs from unavailable");
    revision = cache.GetRevision();
    source.ReputationRows->push_back("T:1124:1065353216:1065353216:1065353216:1065353216:1065353216");
    cache.Get(start + 4s, 1, false, build);
    Require(cache.GetRevision() != revision, "faction rate reload changes revision");
    revision = cache.GetRevision();
    source.ReputationRows.reset();
    cache.Get(start + 6s, 1, false, build);
    Require(cache.GetRevision() != revision, "unavailable catalog cannot retain stale live rates");
    revision = cache.GetRevision();
    source.ReportResets = true;
    cache.Get(start + 8s, 1, false, build);
    Require(cache.GetRevision() != revision, "reset reporting changes are observed");
    Require(cache.GetCatalogRevision() == initialCatalogRevision,
        "auxiliary player sampling catalogs do not invalidate unchanged wire Caps/Rows");
    revision = cache.GetRevision();
    source.Caps = "RESETS,HEARTBEAT";
    source.Rows = {"P:QUEST_RESETS:1792058400:1793527200"};
    cache.Get(start + 10s, 1, false, build);
    Require(cache.GetRevision() != revision, "reset deadlines are part of cached data");
    revision = cache.GetRevision();
    source.Rows.clear();
    cache.Get(start + 12s, 1, false, build);
    Require(cache.GetRevision() != revision, "removed rows are not retained");
}

void TestPlayerChecks()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"HEARTBEAT", {}, std::nullopt, false};
    auto build = [&]() { return source; };
    cache.Get(start, 1, false, build);
    auto const revision = cache.GetRevision();
    Require(!cache.ShouldCheckPlayer(start + 1s, start, revision, false, false, false),
        "unchanged player skips intermediate tick");
    Require(cache.ShouldCheckPlayer(start + 2s, start, revision, false, false, false),
        "player rates/auras/context are checked at interval");
    Require(cache.ShouldCheckPlayer(start + 1s, start, revision, false, true, false),
        "requesting player is checked immediately");
    Require(cache.ShouldCheckPlayer(start + 1s, start, revision, true, false, false),
        "dirty state bypasses interval");
    Require(cache.ShouldCheckPlayer(start + 1s, start, revision, false, false, true),
        "initial/lost snapshot is rebuilt");
    source.LiveRows = {"P:KA_FINISHED:1"};
    cache.Get(start + 1s, 1, true, build);
    Require(cache.ShouldCheckPlayer(start + 1s, start, revision, false, false, false),
        "new common state reaches players checked recently");
}

void TestPlayerSignatures()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"EVENTS,HEARTBEAT", {"E:33:0:0"}, std::nullopt, false};
    source.LiveRows = {"P:EVENT_COUNT:1", "A:33", "U:3426:1"};
    auto build = [&]() { return source; };
    cache.Get(start, 1, false, build);
    std::string caps = source.Caps + ",VALUES,QUESTGIVERS,QUELDANAS";
    std::vector<std::string> personal = {"W:198:1", "P:QG_CONTEXT:0:12", "G:823:79942:0:F130000337013846"};
    auto signature = [&]()
    {
        auto rows = source.LiveRows;
        rows.insert(rows.end(), personal.begin(), personal.end());
        auto const before = rows;
        auto const result = cache.BuildPlayerSignature(caps,
            std::span<std::string const>(rows).subspan(source.LiveRows.size()));
        Require(rows == before, "signature construction preserves the complete wire rows");
        Require(result.find(";P:EVENT_COUNT:") == std::string::npos
            && result.find(";A:33") == std::string::npos && result.find(";U:3426:") == std::string::npos,
            "common revision replaces shared live row text in player signatures");
        auto const catalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'A'), source.Rows);
        Require(catalog.has_value(), "signature fixture has a complete static catalog");
        auto const messages = QuestieBridge::BuildSnapshotMessages("signature", 1, caps, rows, *catalog, true);
        Require(messages.has_value(), "signature optimization retains serializable complete snapshots");
        std::string wire;
        for (auto const& message : *messages)
            wire += message;
        for (auto const& row : source.LiveRows)
            Require(wire.find(row) != std::string::npos, "shared live rows still reach the wire");
        for (auto const& row : personal)
            Require(result.find(';' + row) != std::string::npos, "personal rows remain in the signature");
        return result;
    };
    auto previous = signature();
    cache.Get(start + 2s, 1, false, build);
    Require(signature() == previous, "unchanged state does not request an unnecessary snapshot");
    source.LiveRows[2] = "U:3426:2";
    cache.Get(start + 3s, 1, true, build);
    auto current = signature();
    Require(current != previous, "shared progress changes still trigger a snapshot through common revision");
    previous = current;
    source.LiveRows = {"P:EVENT_COUNT:0", "U:3426:2"};
    cache.Get(start + 4s, 1, true, build);
    current = signature();
    Require(current != previous, "clearing shared event selections still triggers a snapshot");
    previous = current;
    personal[0] = "W:198:2";
    current = signature();
    Require(current != previous, "personal state changes trigger snapshots without a shared revision change");
    previous = current;
    personal.pop_back();
    current = signature();
    Require(current != previous, "removing a private observation changes the signature");
    previous = current;
    caps = "EVENTS,VALUES,QUESTGIVERS,QUELDANAS";
    current = signature();
    Require(current != previous, "capability changes trigger snapshots even with identical rows");
    previous = current;
    source.LiveRows.clear();
    source.Rows.clear();
    source.Caps = caps = "HEARTBEAT";
    personal.clear();
    cache.Get(start + 5s, 2, true, build);
    Require(signature() != previous, "an empty shared prefix remains valid after capability removal");
}

void TestLiveAndCatalogRevisions()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"EVENTS,VALUES,QUESTPOOLS,WINTERGRASP,KALUAK,HEARTBEAT",
        {"E:5:0:0", "Q:13830:5676", "Q:13832:5676", "D:20001"}, std::nullopt, false};
    source.LiveRows = {"P:EVENT_COUNT:0", "P:POOL_COUNT:1", "S:13830", "U:21:50",
        "R:13830:0", "P:WG_STATE:1:0:0", "P:KA_FINISHED:0", "P:SC_ACTIVE:0"};
    auto const original = source;
    int builds = 0;
    auto build = [&]() { ++builds; return source; };
    auto const first = cache.Get(start, 1, false, build);
    auto revision = cache.GetRevision();
    auto catalogRevision = cache.GetCatalogRevision();
    auto now = start;
    auto liveChange = [&]()
    {
        now += 100ms;
        cache.Get(now, 1, true, build);
        Require(cache.GetRevision() != revision, "every advertised live change advances common revision");
        Require(cache.GetCatalogRevision() == catalogRevision, "live changes retain the static catalog revision");
        Require(!cache.CanRenewPlayer(now, start, revision), "old common revision cannot authorize heartbeat renewal");
        revision = cache.GetRevision();
    };
    source.LiveRows[0] = "P:EVENT_COUNT:1";
    source.LiveRows.push_back("A:5");
    liveChange();
    source.LiveRows = original.LiveRows;
    liveChange();
    Require(first == original && cache.Get(now, 1, false, build) == original,
        "false/true/false event revisits preserve the original owned catalog and complete false state");
    source.LiveRows[3] = "U:21:51";
    liveChange();
    source.LiveRows[4] = "R:13830:1";
    liveChange();
    source.LiveRows[5] = "P:WG_STATE:1:1:1";
    liveChange();
    source.LiveRows[6] = "P:KA_FINISHED:1";
    liveChange();
    source.LiveRows[7] = "P:SC_ACTIVE:1";
    liveChange();
    source.LiveRows[2] = "S:13832";
    liveChange();
    auto const beforeDirtyBuilds = builds;
    cache.Get(now + 1ms, 1, true, build);
    Require(builds == beforeDirtyBuilds + 1 && cache.GetRevision() == revision
        && cache.GetCatalogRevision() == catalogRevision, "dirty unchanged content rebuilds without advancing either revision");
    auto catalogChange = [&]()
    {
        now += 100ms;
        cache.Get(now, 1, true, build);
        Require(cache.GetRevision() != revision && cache.GetCatalogRevision() != catalogRevision,
            "structural catalog changes invalidate both revisions");
        revision = cache.GetRevision();
        catalogRevision = cache.GetCatalogRevision();
    };
    source.Rows[0] = "E:5:141:0";
    catalogChange();
    source.Rows[1] = "Q:13830:5677";
    catalogChange();
    source.Rows.pop_back();
    catalogChange();
    source.Caps += ",SCOURGE";
    catalogChange();
    source.Rows.push_back("P:QUEST_RESETS:1792058400:1793527200");
    catalogChange();
}

void TestLiveDeliveryCoalescing()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"EVENTS,VALUES,QUESTDISABLES,HEARTBEAT", {"E:5:0:0"}, std::nullopt, false};
    for (int id = 1; id <= 673; ++id)
        source.Rows.push_back("D:" + std::to_string(20000 + id));
    source.LiveRows = {"P:EVENT_COUNT:0", "U:21:0"};
    auto build = [&]() { return source; };
    cache.Get(start, 1, false, build);
    auto encodedRevision = cache.GetCatalogRevision();
    auto catalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'A'), source.Rows);
    Require(catalog.has_value(), "coalescing fixture has an owned static catalog");
    auto const initial = QuestieBridge::BuildSnapshotMessages("initial", 1, source.Caps, source.LiveRows, *catalog);
    Require(initial && initial->size() > 16, "initial batch spans many bounded updates");
    auto const sampledRevision = cache.GetRevision();
    std::vector<QuestieBridge::SnapshotDelivery> subscribers;
    for (int player = 0; player < 1000; ++player)
        subscribers.emplace_back(*initial, start);
    std::vector<std::size_t> sent(subscribers.size());
    std::size_t encodings = 1;
    for (int tick = 1; tick <= 16; ++tick)
    {
        auto const now = start + tick * 100ms;
        source.LiveRows[1] = "U:21:" + std::to_string(tick);
        cache.Get(now, 1, true, build);
        // Model the catalog owner's revision gate; delivery and renewal decisions
        // below call production helpers, without reproducing the world update loop.
        if (cache.GetCatalogRevision() != encodedRevision)
        {
            catalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'B'), source.Rows);
            encodedRevision = cache.GetCatalogRevision();
            ++encodings;
        }
        Require(catalog.has_value(), "cached static catalog remains available");
        for (std::size_t player = 0; player < subscribers.size(); ++player)
        {
            Require(subscribers[player].CanContinue(now, std::string(64, 'A'), catalog->Id),
                "continuous live changes cannot cancel an unexpired batch with matching catalog identity");
            subscribers[player].Dispatch(1, [&](std::string const& message)
            {
                Require(message == (*initial)[sent[player]++], "live updates cannot mix rows into an in-flight batch");
            });
            Require(!cache.CanRenewPlayer(now, start, sampledRevision),
                "in-flight sampled revision cannot heartbeat over newer common state");
        }
    }
    Require(encodings == 1, "1000 modeled subscribers reuse one catalog across continuous live changes");
    for (std::size_t player = 0; player < subscribers.size(); ++player)
    {
        auto& delivery = subscribers[player];
        delivery.Dispatch(initial->size(), [&](std::string const& message)
        {
            Require(message == (*initial)[sent[player]++], "pending batch finishes its original snapshot in order");
        });
        Require(delivery.Complete() && sent[player] == initial->size(), "all modeled subscribers complete the original batch");
    }
    auto const latest = QuestieBridge::BuildSnapshotMessages("latest", 2, source.Caps, source.LiveRows, *catalog, true);
    Require(latest && BeginFields(*latest)[8] == "R" && BeginFields(*latest)[5] == "2",
        "next snapshot references the retained catalog and contains only the latest live rows");
    QuestieBridge::SnapshotDelivery replacement(*latest, start + 1700ms);
    std::vector<std::string> delivered;
    replacement.Dispatch(latest->size(), [&](auto const& message) { delivered.push_back(message); });
    Require(replacement.Complete() && delivered == *latest, "coalesced latest snapshot completes through actual delivery");
    Require(!cache.CanRenewPlayer(start + 1800ms, start, sampledRevision)
        && cache.CanRenewPlayer(start + 1800ms, start + 1600ms, cache.GetRevision()),
        "renewal requires verification of the latest sampled common revision after old batch completion");
    auto const unchangedRevision = cache.GetRevision();
    cache.Get(start + 1800ms, 1, true, build);
    Require(cache.GetRevision() == unchangedRevision && cache.GetCatalogRevision() == encodedRevision && encodings == 1,
        "unchanged refresh does not require another catalog encoding");
    Require(subscribers[0].CanContinue(start + 3999ms, catalog->Id, catalog->Id)
        && !subscribers[0].CanContinue(start + 4s, catalog->Id, catalog->Id),
        "continuous live updates retain the original four-second deadline");
    source.Rows[0] = "E:5:141:0";
    cache.Get(start + 1900ms, 1, true, build);
    Require(cache.GetCatalogRevision() != encodedRevision, "event metadata change requires a new catalog");
    auto const changed = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'B'), source.Rows);
    QuestieBridge::SnapshotDelivery structural(*latest, start + 1700ms);
    Require(changed && !structural.CanContinue(start + 1900ms, catalog->Id, changed->Id),
        "catalog identity mismatch cancels even a recent pending batch");
    std::cout << "Modeled live delivery: 1000 subscribers, 16 live changes, one static catalog encoding\n";
}

void TestAckRenewals()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    CommonState source{"HEARTBEAT", {}, std::nullopt, false};
    std::size_t builds = 0;
    auto build = [&]() { ++builds; return source; };
    cache.Get(start, 1, false, build);
    auto const revision = cache.GetRevision();
    for (int subscriber = 0; subscriber < 1000; ++subscriber)
    {
        auto const now = start + 100ms + std::chrono::microseconds(subscriber);
        cache.Get(now, 1, false, build);
        Require(cache.CanRenewPlayer(now, start, revision), "matching ACK can renew recently checked state");
        Require(!cache.ShouldCheckPlayer(now, start, revision, false, false, false),
            "matching ACK does not force another player evaluation");
    }
    Require(builds == 1, "1000 matching idle ACKs share one existing common sample");
    Require(!cache.CanRenewPlayer(start + 2s, start, revision), "ACK cannot renew overdue player state");
    Require(!cache.CanRenewPlayer(start + 1s, start, revision + 1), "ACK cannot renew an unmatched common revision");
    source.LiveRows = {"P:EVENT_COUNT:1", "A:5"};
    cache.Get(start + 1s, 1, true, build);
    Require(!cache.CanRenewPlayer(start + 1s, start, revision), "changed shared state requires player verification");
    cache.Reset();
    Require(!cache.CanRenewPlayer(start + 1s, start, cache.GetRevision()), "reset state cannot authorize a heartbeat");
    std::cout << "Idle ACKs: 1000 subscribers, one shared build, no forced player checks\n";
}

void TestSubscriberScheduling()
{
    std::map<std::uint32_t, int> subscribers;
    for (std::uint32_t id = 1; id <= 1000; ++id)
        subscribers.emplace(id, 0);
    std::uint32_t cursor = 0;
    std::size_t visits = 0, updates = 0;
    while (visits < subscribers.size())
    {
        std::size_t checked = 0;
        while (checked < 32 && visits < subscribers.size())
        {
            auto const next = QuestieBridge::NextSubscriber(subscribers, cursor);
            Require(next != subscribers.end(), "active subscriber remains schedulable");
            ++next->second;
            ++checked;
            ++visits;
        }
        ++updates;
        Require(checked <= 32, "subscriber scheduling respects the per-update count allowance");
    }
    for (auto const& [id, count] : subscribers)
    {
        (void)id;
        Require(count == 1, "a bounded round visits every subscriber without starvation");
    }
    Require(updates == 32, "1000 subscribers spread over 32 bounded updates");
    Require(QuestieBridge::NextSubscriber(subscribers, cursor)->first == 1, "cursor wraps after the last subscriber");
    cursor = 500;
    subscribers.erase(cursor);
    Require(QuestieBridge::NextSubscriber(subscribers, cursor)->first == 501,
        "logout at the cursor preserves progress");
    cursor = 1000;
    subscribers.emplace(1001, 0);
    Require(QuestieBridge::NextSubscriber(subscribers, cursor)->first == 1001, "new subscribers enter the next round");
    subscribers.erase(1001);
    Require(QuestieBridge::NextSubscriber(subscribers, cursor)->first == 1, "erased final cursor wraps safely");
    subscribers.clear();
    Require(QuestieBridge::NextSubscriber(subscribers, cursor) == subscribers.end(),
        "empty subscriber list remains idle");
}

void TestSnapshotDelivery()
{
    auto const start = StateClock::time_point{};
    std::vector<std::string> shared;
    for (std::uint32_t id = 1; id <= 673; ++id)
        shared.push_back("D:" + std::to_string(id));
    auto const catalog = QuestieBridge::BuildSnapshotCatalog(std::string(64, 'A'), shared);
    Require(catalog.has_value(), "delivery fixture has a complete shared catalog");
    auto messages = QuestieBridge::BuildSnapshotMessages("first", 1, "QUESTDISABLES,HEARTBEAT", {}, *catalog);
    Require(messages && messages->size() > 8, "full catalog requires multiple bounded dispatches");
    QuestieBridge::SnapshotDelivery delivery(*messages, start);
    std::vector<std::string> sent;
    auto send = [&](std::string const& message) { sent.push_back(message); };
    Require(delivery.Dispatch(0, send) == 0 && delivery.Remaining() == messages->size(),
        "zero allowance sends nothing and preserves the complete pending batch");
    Require(delivery.Dispatch(4, send) == 4 && sent.front() == messages->front()
        && !delivery.Complete() && delivery.Remaining() == messages->size() - 4,
        "dispatch is bounded and does not send END before the remaining parts");
    while (!delivery.Complete())
        Require(delivery.Dispatch(8, send) <= 8, "every subsequent dispatch respects its allowance");
    Require(sent == *messages && delivery.Remaining() == 0 && delivery.Dispatch(8, send) == 0,
        "all parts preserve order and completed batches cannot resend");
    Require(!delivery.Expired(start + 3999ms) && delivery.Expired(start + 4s),
        "pending delivery expires before the client's five-second assembly timeout");

    auto source = *messages;
    QuestieBridge::SnapshotDelivery owned(source, start);
    source.front() = "changed";
    sent.clear();
    owned.Dispatch(1, send);
    Require(sent == std::vector<std::string>{messages->front()}, "queued messages own their copied values");

    std::optional<QuestieBridge::SnapshotDelivery> pending;
    pending.emplace(*messages, start);
    sent.clear();
    pending->Dispatch(1, send);
    Require(pending->Expired(start + 4s), "partial delivery becomes stale without completing authority");
    pending.reset();
    auto replacement = QuestieBridge::BuildSnapshotMessages("replacement", 2, "HEARTBEAT", {});
    Require(replacement.has_value(), "replacement snapshot is complete");
    pending.emplace(*replacement, start + 4s);
    pending->Dispatch(replacement->size(), send);
    Require(pending->Complete() && sent.size() == replacement->size() + 1,
        "owner can discard an expired or superseded queue and deliver a replacement");
    for (std::size_t index = 0; index < replacement->size(); ++index)
        Require(sent[index + 1] == (*replacement)[index], "replacement never sends leftover parts from the old token");
    pending.reset();
    Require(!pending, "disconnect or disable releases all queued messages");
}

void TestResetAndIdleWork()
{
    CommonStateCache cache;
    auto const start = StateClock::time_point{};
    int builds = 0;
    auto build = [&]() { ++builds; return CommonState{"HEARTBEAT", {}, std::nullopt, false}; };
    cache.Get(start, 1, false, build);
    auto const revision = cache.GetRevision();
    cache.Reset();
    cache.Get(start + 100ms, 1, false, build);
    Require(builds == 2 && cache.GetRevision() != revision, "idle/disable reset forces a fresh next sample");

    CommonStateCache idle;
    builds = 0;
    int playerChecks = 0;
    StateClock::time_point lastCheck{};
    std::uint64_t lastRevision = 0;
    for (int tick = 0; tick < 1000; ++tick)
    {
        auto const now = start + std::chrono::seconds(tick);
        idle.Get(now, 1, false, build);
        if (idle.ShouldCheckPlayer(now, lastCheck, lastRevision, false, false, tick == 0))
        {
            ++playerChecks;
            lastCheck = now;
            lastRevision = idle.GetRevision();
        }
    }
    Require(builds == 500 && playerChecks == 500, "1000 quiet ticks need only 500 builds/player checks");
}

void TestQuestgiverCatalog()
{
    CommonStateCache cache;
    CommonState source{"HEARTBEAT", {}, std::nullopt, false};
    source.StarterEntries = {823, 824};
    source.RestrictedGiverTemplates = {823};
    source.GiverTemplateRows = {"P:QGT_COUNT:1", "N:823"};
    int builds = 0;
    auto build = [&]() { ++builds; return source; };
    auto const start = StateClock::time_point{};
    auto const& common = cache.Get(start, 1, false, build);
    auto const revision = cache.GetRevision();
    for (int player = 0; player < 1000; ++player)
    {
        std::vector<std::string> rows(4091, "E:1:0:0");
        std::string caps = "QUESTGIVERS";
        Require(common.AppendGiverTemplates(rows, caps, 3), "complete catalog fits exact row boundary");
        Require(rows.size() == 4093 && rows.back() == "N:823", "every player receives the complete shared catalog");
        Require(caps == "QUESTGIVERS,QUESTGIVERTEMPLATES", "only complete catalogs advertise authority");
    }
    Require(builds == 1 && common.RestrictedGiverTemplates.contains(823), "global catalog shared across players");
    std::vector<std::string> rows(4092, "E:1:0:0");
    auto const before = rows;
    std::string caps = "QUESTGIVERS";
    Require(!common.AppendGiverTemplates(rows, caps, 3) && rows == before && caps == "QUESTGIVERS",
        "overflow does not append a partial catalog or capability");
    source.RestrictedGiverTemplates.clear();
    source.GiverTemplateRows = {"P:QGT_COUNT:0"};
    cache.Get(start + 2s, 1, false, build);
    Require(cache.GetRevision() != revision, "template restoration advances revision");
    auto const restored = cache.GetRevision();
    cache.Get(start + 4s, 1, false, build);
    Require(cache.GetRevision() == restored, "unchanged template polling preserves revision");
    source.GiverTemplateRows.reset();
    cache.Get(start + 5s, 2, true, build);
    Require(cache.GetRevision() != restored, "capability removal invalidates global state");
    rows.clear();
    Require(!cache.Get(start + 5s, 2, false, build).AppendGiverTemplates(rows, caps, 0),
        "unavailable catalog is distinct from an empty complete catalog");
}

struct VisibleFixtureCreature
{
    std::uint32_t Entry = 823;
    std::uint32_t Spawn = 111;
    int Map = 1;
    int Zone = 2;
    bool InWorld = true;
    bool Alive = true;
    bool AtClient = true;
    bool InSight = true;
    bool InPhase = true;
    bool Detectable = true;
    bool Hostile = false;

    std::uint32_t GetSpawnId() const { return Spawn; }
    std::uint32_t GetEntry() const { return Entry; }
    int GetMap() const { return Map; }
    int GetZoneId() const { return Zone; }
    bool IsInWorld() const { return InWorld; }
    bool IsAlive() const { return Alive; }
    bool IsHostileTo(void const*) const { return Hostile; }
};

struct VisibleFixtureObject
{
    VisibleFixtureCreature* Creature = nullptr;
    VisibleFixtureCreature* ToCreature() const { return Creature; }
};

struct VisibleFixtureObserver
{
    int Map = 1;
    int Zone = 2;
    bool CanDetect = true;
    std::size_t Iterations = 0;
    std::size_t Visits = 0;
    std::vector<VisibleFixtureObject> Visible;

    int GetMap() const { return Map; }
    int GetZoneId() const { return Zone; }
    bool HaveAtClient(VisibleFixtureCreature const* creature) const { return creature->AtClient; }
    bool CanSeeOrDetect(VisibleFixtureCreature const* creature, bool ignoreStealth, bool distanceCheck) const
    {
        return CanDetect && creature->InPhase && (ignoreStealth || creature->Detectable)
            && (!distanceCheck || creature->InSight);
    }

    template <typename Visitor>
    void DoForAllVisibleWorldObjects(Visitor&& visitor)
    {
        ++Iterations;
        for (auto& object : Visible)
        {
            ++Visits;
            visitor(&object);
        }
    }
};

void TestVisibleCandidates()
{
    VisibleFixtureCreature valid, sameSpawnVariant;
    VisibleFixtureObserver player;
    player.Visible = {{nullptr}, {&valid}, {&sameSpawnVariant}};
    auto const initial = QuestieBridge::CollectObservableQuestCreatures<VisibleFixtureCreature>(&player, {823});
    Require(initial == std::vector<VisibleFixtureCreature*>{&valid, &sameSpawnVariant},
        "visible stationary creatures and distinct same-spawn variants remain candidates");
    Require(player.Iterations == 1 && player.Visits == 3, "collector visits only the player's visible object list once");

    for (int exclusion = 0; exclusion < 11; ++exclusion)
    {
        auto rejected = valid;
        switch (exclusion)
        {
            case 0: rejected.Spawn = 0; break;
            case 1: rejected.Map = 3; break;
            case 2: rejected.Zone = 3; break;
            case 3: rejected.InWorld = false; break;
            case 4: rejected.Alive = false; break;
            case 5: rejected.AtClient = false; break;
            case 6: rejected.InSight = false; break;
            case 7: rejected.InPhase = false; break;
            case 8: rejected.Detectable = false; break;
            case 9: rejected.Hostile = true; break;
            case 10: rejected.Entry = 824; break;
        }
        player.Visible = {{&rejected}};
        Require(QuestieBridge::CollectObservableQuestCreatures<VisibleFixtureCreature>(&player, {823}).empty(),
            "spawn identity, map, zone, life, client, distance, phase, detection and hostility remain mandatory");
    }
    player.Visible = {{&valid}};
    VisibleFixtureObserver other;
    other.Visible = {{&valid}};
    other.CanDetect = false;
    Require(QuestieBridge::CollectObservableQuestCreatures<VisibleFixtureCreature>(&player, {823}).size() == 1
        && QuestieBridge::CollectObservableQuestCreatures<VisibleFixtureCreature>(&other, {823}).empty(),
        "the same visible creature is sampled independently for each observer");
    player.Visible.clear();
    Require(QuestieBridge::CollectObservableQuestCreatures<VisibleFixtureCreature>(&player, {823}).empty(),
        "next collection cannot reuse pointers from a prior tick");
    Require(initial.size() == 2, "each returned vector owns its entries independently of the observer list");
}

void TestObservableCreatures()
{
    struct Creature
    {
        bool Questgiver = true;
    } creature;
    struct Observer
    {
        bool AtClient = false;
        bool InSight = false;
        bool InPhase = true;
        bool Detectable = true;

        bool HaveAtClient(Creature const*) const { return AtClient; }
        bool CanSeeOrDetect(Creature const*, bool ignoreStealth = false, bool distanceCheck = false) const
        {
            return InPhase && (ignoreStealth || Detectable) && (!distanceCheck || InSight);
        }
    } far, near;
    Require(creature.Questgiver && far.CanSeeOrDetect(&creature),
        "a distant loaded questgiver passes the former distance-blind check");
    Require(!QuestieBridge::IsQuestCreatureObservable(&far, &creature),
        "distant loaded questgiver cannot supply a positive override or patrol sample");
    near.AtClient = true;
    near.InSight = true;
    Require(QuestieBridge::IsQuestCreatureObservable(&near, &creature),
        "nearby client-visible questgiver can supply a live override and patrol sample");
    Require(!QuestieBridge::IsQuestCreatureObservable(&far, &creature),
        "another player's visibility cannot make the same creature observable");
    near.InSight = false;
    Require(!QuestieBridge::IsQuestCreatureObservable(&near, &creature),
        "leaving sight range invalidates an observation even before client visibility unlinks");
    far.InSight = true;
    Require(!QuestieBridge::IsQuestCreatureObservable(&far, &creature),
        "in-range creature not yet present at the client cannot be reported");
    near.InSight = true;
    near.InPhase = false;
    Require(!QuestieBridge::IsQuestCreatureObservable(&near, &creature),
        "client membership never bypasses player-specific phasing");
    near.InPhase = true;
    near.Detectable = false;
    Require(!QuestieBridge::IsQuestCreatureObservable(&near, &creature),
        "client membership never bypasses current detection or ignores stealth");
}

}

int main()
{
    try
    {
        TestRefreshAndOwnership();
        TestDirtyRequestsAndCapabilityReload();
        TestCatalogChanges();
        TestPlayerChecks();
        TestLiveAndCatalogRevisions();
        TestPlayerSignatures();
        TestLiveDeliveryCoalescing();
        TestAckRenewals();
        TestSubscriberScheduling();
        TestSnapshotDelivery();
        TestResetAndIdleWork();
        TestQuestgiverCatalog();
        TestVisibleCandidates();
        TestObservableCreatures();
        TestWireCapabilities();
        TestSnapshotEncoding();
        TestSnapshotCatalogs();
        TestCatalogWireReduction();
        TestQuestConditions();
        std::cout << "Common state cache, conditions, delivery and protocol: 19 regression groups passed\n";
        return 0;
    }
    catch (std::exception const& error)
    {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
